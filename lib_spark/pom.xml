<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cascada</groupId>
        <artifactId>cascada-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cascada-lib-spark</artifactId>
    <name>Cascada Library - Spark + Delta executor</name>
    <description>
        The production SparkQueryExecutorPort adapter: builds a Spark 4.1.1 SparkSession (local or
        Kubernetes — identical code, only config differs) with Delta Lake extensions, runs physical
        SQL over Delta tables, and maps the Spark Row result into the cache's framework-free ResultFrame.
        Ported from data_collector/src/core/spark/spark_manager.py + cluster-deployment/spark_configs.py.

        The Java 21 driver image (Spark 4.1.1 + Gluten +
        Velox + Delta) supplies the Spark/Delta runtime, so those dependencies are `provided` here — this
        module compiles against them and contributes the adapter + the pure, fully-tested config builder.
    </description>



    <dependencies>
        <dependency>
            <groupId>com.cascada</groupId>
            <artifactId>cascada-lib-cache</artifactId>
        </dependency>

        <!-- Supplied by the Spark cluster image at runtime (see deployment spark.jars); provided here. -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_2.13</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Gluten's native planner references Spark/Hive file-format classes. -->
        <dependency><groupId>org.apache.spark</groupId><artifactId>spark-hive_2.13</artifactId><version>${spark.version}</version><scope>provided</scope></dependency>
        <dependency>
            <groupId>io.delta</groupId>
            <artifactId>delta-spark_4.1_2.13</artifactId>
            <version>${delta.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>
    </dependencies>
</project>
